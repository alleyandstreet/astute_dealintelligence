generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                 @id @default(cuid())
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  username                   String                 @unique
  password                   String
  email                      String?
  role                       String                 @default("member")
  isActive                   Boolean                @default(true)
  lastLogin                  DateTime?
  logs                       ActivityLog[]
  businesses                 Business[]
  assignedDeals              Deal[]                 @relation("DealOwner")
  dealsMoved                 Deal[]                 @relation("DealLastMovedBy")
  scheduledPosts             ScheduledPost[]
  savedBlueprints            SavedBlueprint[]
  assignedCrmTasks           CrmTask[]              @relation("TaskAssignee")
  createdCrmTasks            CrmTask[]              @relation("TaskCreator")
  attendanceSessions         InternAttendance[]     @relation("InternAttendanceUser")
  featureAccesses            UserFeatureAccess[]
  onboardingTemplatesCreated OnboardingTemplate[]   @relation("OnboardingTemplateCreator")
  onboardingAssignments      OnboardingAssignment[] @relation("OnboardingAssignee")
  onboardingAssignmentsSet   OnboardingAssignment[] @relation("OnboardingAssignedBy")
  notesAuthored              Note[]                 @relation("NoteAuthor")
}

model SavedBlueprint {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title    String
  prompt   String
  format   String
  persona  String
  thinking String?

  // JSON Blobs for the flexible analysis and structure
  blueprint Json // The "Viral Intelligence" (trendingHooks, analysis, viralGeometry)
  outline   Json // The "Architected Script" (title, hook, structure, cta, metaData)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  description String?
  industry    String?
  valuation   Float?
  revenue     Float?
  status      String   @default("active")
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Deal {
  id              String     @id @default(cuid())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  name            String
  description     String?
  industry        String?
  location        String?
  url             String?
  askingPrice     Float?
  revenue         Float?
  revenueType     String?
  ebitda          Float?
  sde             Float?
  valuationMin    Float?
  valuationMax    Float?
  source          String
  sourceId        String?    @unique
  sourceName      String?
  redditUrl       String?
  redditAuthor    String?
  redditScore     Int?
  redditComments  Int?
  status          String     @default("new_leads")
  aiSummary       String?
  viabilityScore  Int?
  motivationScore Int?
  dealQuality     Int?
  riskFlags       String?
  sellerSignals   String?
  businessType    String?
  contactReddit   String?
  contactEmail    String?
  contactWebsite  String?
  contactTwitter  String?
  contactLinkedIn String?
  contactDiscord  String?
  ownerId         String?
  owner           User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastMovedById   String?
  lastMovedBy     User?      @relation("DealLastMovedBy", fields: [lastMovedById], references: [id], onDelete: SetNull)
  priority        String     @default("medium")
  nextAction      String?
  nextActionAt    DateTime?
  lastContactedAt DateTime?
  tags            DealTag[]
  notes           Note[]
  outreaches      Outreach[]
  crmTasks        CrmTask[]

  @@index([status])
  @@index([ownerId])
  @@index([nextActionAt])
  @@index([source, createdAt])
}

model Note {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  content    String
  authorName String?
  userId     String?
  dealId     String
  user       User?    @relation("NoteAuthor", fields: [userId], references: [id], onDelete: SetNull)
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, createdAt])
  @@index([userId])
}

model Outreach {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  type      String
  message   String
  status    String   @default("sent")
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  color String    @default("#06b6d4")
  deals DealTag[]
}

model DealTag {
  id     String @id @default(cuid())
  dealId String
  tagId  String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
}

model SearchConfig {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  name       String
  subreddits String
  keywords   String
  isDefault  Boolean  @default(false)
}

model ScanLog {
  id           String    @id @default(cuid())
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  status       String    @default("running")
  postsScanned Int       @default(0)
  dealsFound   Int       @default(0)
  errors       String?
}

model TeamMessage {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  content        String
  sender         String   @default("User")
  senderEmail    String?
  attachment     String?
  attachmentType String?
  editHistory    Json?
  deletedFor     Json     @default("[]")
}

model ScheduledPost {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  caption         String
  hashtags        Json     @default("[]")
  scheduledFor    DateTime
  status          String   @default("scheduled")
  mediaUrls       String
  userId          String
  platform        String   @default("instagram")
  reminderEnabled Boolean  @default(false)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CrmTask {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  title        String
  description  String?
  status       String    @default("todo")
  priority     String    @default("medium")
  dueDate      DateTime?
  completedAt  DateTime?
  notes        String?
  dealId       String?
  assignedToId String?
  createdById  String?
  deal         Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignedTo   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([dueDate])
}

model InternAttendance {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String
  clockInAt       DateTime  @default(now())
  clockOutAt      DateTime?
  durationMinutes Int?
  notes           String?
  user            User      @relation("InternAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clockInAt])
  @@index([clockOutAt])
}

model AppSetting {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  key       String   @unique
  value     Json
}

model UserFeatureAccess {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  featureKey String
  enabled    Boolean  @default(true)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([featureKey])
}

model OnboardingTemplate {
  id          String                 @id @default(cuid())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  name        String
  description String?
  steps       Json                   @default("[]")
  isDefault   Boolean                @default(false)
  isActive    Boolean                @default(true)
  createdById String?
  createdBy   User?                  @relation("OnboardingTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignments OnboardingAssignment[]

  @@index([isDefault, isActive])
}

model OnboardingAssignment {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  userId       String
  templateId   String
  status       String             @default("assigned")
  progress     Json
  dueDate      DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  notes        String?
  assignedById String?
  user         User               @relation("OnboardingAssignee", fields: [userId], references: [id], onDelete: Cascade)
  template     OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  assignedBy   User?              @relation("OnboardingAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([templateId])
}
